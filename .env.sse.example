# CanvasToAPI SSE candidate deployment
# Copy to .env.sse or export these variables before docker compose.

HOST_PORT=7862
API_KEYS=replace-with-a-strong-key
TZ=Asia/Shanghai

STREAMING_MODE=fake
ROUND=round
SESSION_ERROR_THRESHOLD=3
MAX_RETRIES=3
RETRY_DELAY=2000

FORCE_THINKING=false
FORCE_WEB_SEARCH=false
FORCE_URL_CONTEXT=false

# SSE browser auth protection
SSE_PENDING_TOKEN_LIMIT=100
SSE_AUTH_RATE_LIMIT_MAX=30
SSE_AUTH_RATE_LIMIT_WINDOW_MS=300000
